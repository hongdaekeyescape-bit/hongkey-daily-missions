# 관리자 화면 PIN (서버 전용)
ADMIN_PIN=1234
# 쿠키 서명 시크릿 (아무 긴 랜덤 문자열)
ADMIN_SECRET=change-me-to-a-long-random-string

# 매장 기기 등록 코드 (비우면 기기 제한 없음)
DEVICE_CODE=

# 텔레그램 미션 완료 알림 (비우면 알림 끔). rmcheckbot 토큰 + 보낼 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
